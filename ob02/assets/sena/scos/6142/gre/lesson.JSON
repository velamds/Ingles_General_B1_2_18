t", "content": "let"}], "selected": 0, "id": 1}]}, {"_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn7le18ob02re6aud05"}]}, {"type": "incorrect", "contents": [{"type": "text", "content": "Howe"}]}, {"type": "post_question", "contents": {"type": "", "content": "do we know which road to follow?"}}, {"type": "objective", "content": "secondary_8"}], "id": 2, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": "How"}], "selected": 0, "id": 1}]}], "stimuli_ids": [], "id": 10, "type": "GIW", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Advice is needed."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: \n<span class=\"bullet\">Listen to the audio. </span> \n<span class=\"bullet\">Proofread the sentence. </span> \n<span class=\"bullet\">Click on the incorrect word. </span> \n<span class=\"bullet\">Type in the correct word to complete the sentence.</span>\n<span class=\"bullet\">Use capital letters where necessary. </span>"}]}], "template_override": 1}, {"questions": [{"_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}], "id": 0, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}]}], "stimuli_ids": [], "id": 11, "type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "contents": [{}], "id": 0}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn7le18ob02re2aud01", "coverimg": "engenn7le18ob02re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn7le18ob02re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: I've been reading up on the different types of rice that you told me about. Marleene, a journalist who works at the magazine with me, is doing a series which is entitled <span class=\"italic\">Rice around the World</span>. She'd be keen on doing a food article that covered your cookout.<br/>\n<span class=\"strong\">Vanessa</span>: Really? I think \u2018cook-in' would be a word that describes it better. Excuse me, Miss. Can you tell me where to find the rice? <br/>\n<span class=\"strong\">Clerk</span>: Rice is in aisle 3. <br/>\n<span class=\"strong\">Vanessa</span>: Thank you. Come on Sally.", "id": 1, "time": "100", "image": "engenn7le18ob02re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: There are so many kinds. How do you know which one to use?<br/>\n<span class=\"strong\">Vanessa</span>: That depends on the dish. We want basmati, Japanese short rice and jasmine-scented rice. They're for my version of some recipes that I read about in an international newspaper.<br/>\n<span class=\"strong\">Sally</span>: Hey! Here's the jasmine rice that I read about in Marleene's last feature!<br/>\n<span class=\"strong\">Vanessa</span>: The others are there. Now we need coconut milk, mirin, and soy sauce.<br/>\n<span class=\"strong\">Sally</span>: I'll find those.  Oh Miss, can you tell me where to find some items?<br/>\n<span class=\"strong\">Clerk</span>: Certainly. Where's your list? Hmm ... follow me.", "id": 2, "time": "21000", "image": "engenn7le18ob02re2img01.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: That was fast! Miss, I have one more question. How do I know which green tea powder makes the best cake?<br/>\n<span class=\"strong\">Clerk</span>: I like to use this one. It has a nice aroma and the flavor is not too strong.<br/>\n<span class=\"strong\">Sally</span>: Tea in cake?", "id": 3, "time": "50000", "image": "engenn7le18ob02re2img02.jpg"}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "The Rice Cookout"}, {"type": "unit_name", "content": "Know Your Rice"}, {"type": "position", "content": 2}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 18}, {"type": "level", "content": "B1.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Identify and describe events in the news in a range of social and work contexts."}, {"type": "secondary_1", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations."}, {"type": "secondary_2", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations."}, {"type": "secondary_3", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations."}, {"type": "secondary_4", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations."}, {"type": "secondary_5", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations."}, {"type": "secondary_6", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations."}, {"type": "secondary_7", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations."}, {"type": "secondary_8", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Subject and Object Relative Clauses"}, {"type": "describer", "content": "<p>When you want to clarify which person or thing you are talking about, you use a relative clause.</p><p>You can begin a relative clause with <span class=\"italic\">who</span> for people, <span class=\"italic\">which</span> for things or <span class=\"italic\">that</span> for either people or things.</p>You put the relative clause immediately after the noun it talks about."}, {"type": "text", "content": "A subject relative clause describes the subject of the clause."}, {"type": "text", "content": "Example:<br/><span class=\"italic\">The woman <span class=\"strong\">who</span>/<span class=\"strong\">that</span> lives next door to me brought me a cake.</span>"}, {"type": "text", "content": "The clause - <span class=\"italic\">who/that lives next door</span> - refers to the woman. <span class=\"italic\">Who/that</span> is the relative pronoun. It is also the subject of the clause. Who lives next door? The woman."}, {"type": "text", "content": "An object relative clause describes the object of the clause."}, {"type": "text", "content": "Example:<span class=\"italic\"> The apartment <span class=\"strong\">which</span>/<span class=\"strong\">that</span> we rented was near the center of the city.</span>"}, {"type": "text", "content": "The clause - <span class=\"italic\">which/that we rented</span> - refers to the apartment.  <span class=\"italic\">Which/that</span> is the relative pronoun. <span class=\"italic\">We</span> is the subject of the clause. <span class=\"italic\">Apartment</span> is the object of the clause. What did we rent? The apartment."}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Subject Relative Clause</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Object Relative Clause</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'll find these things that are on your list!</span> <br/>(What is on your list? Things)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I've been reading up on the different types of rice that you told me about.</span> <br/>(What did you tell me about? Rice)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">She'd be keen on doing an article that covered your cookout.</span> <br/>(What would it cover? Your cookout)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Here's the jasmine rice that I read about in Marlene's last feature!</span> <br/>(What do you read about? The jasmine rice)\\\"}\"],\"styles\":\"\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Asking For Help or Advice"}, {"type": "describer", "content": " There are several ways to ask for help or advice in English. You can use polite or casual language to do this. Let's look at one particular structure for asking for help."}, {"type": "text", "content": "You can use the structure:<br/>Can/Could + you + show/tell + me + Question word"}, {"type": "text", "content": "Example: <br/> <span class=\"italic\">Can you show me how to use this?</span>"}, {"type": "text", "content": "You can use the structure: <br/>Question word  +  modal + I + verb"}, {"type": "text", "content": "Example: <br/> <span class=\"italic\">Where can I find the scented rice?</span>"}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Example</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Can/Could\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Can/Could you tell me where to find some items? <br/>Can you tell me where to find the rice?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">How do I know which green tea powder makes the best cake?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Where\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Where can I find the rice?</span>\\\"}\"],\"styles\":\"\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "entitled"}, {"type": "definition", "content": "called; named"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She's doing a series that's entitled Rice around the World."}, {"type": "audio", "content": "engenn7le18ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you are shopping for rice."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cookout"}, {"type": "definition", "content": "cooking food outdoors"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We're having a cookout in the backyard this Sunday!"}, {"type": "audio", "content": "engenn7le18ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "basmati"}, {"type": "definition", "content": "long grained rice from southeast Asia"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We're having basmati rice with dinner tonight."}, {"type": "audio", "content": "engenn7le18ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "jasmine-scented"}, {"type": "definition", "content": "sweet smelling"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: This white rice is jasmine-scented."}, {"type": "audio", "content": "engenn7le18ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "coconut milk"}, {"type": "definition", "content": "the liquid from inside a coconut"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We add coconut milk to the rice after it's cooked."}, {"type": "audio", "content": "engenn7le18ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mirin"}, {"type": "definition", "content": "rice wine for cooking"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You use mirin in sushi rice."}, {"type": "audio", "content": "engenn7le18ob02aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to read up on"}, {"type": "definition", "content": "to do research about"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I'll have to read up on different types of rice before I choose one."}, {"type": "audio", "content": "engenn7le18ob02aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "soy sauce"}, {"type": "definition", "content": "a dark brown liquid made from fermented soybeans"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Do you always have soy sauce on your rice?"}, {"type": "audio", "content": "engenn7le18ob02aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "aroma"}, {"type": "definition", "content": "a pleasant smell"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The aroma of the meal made me even hungrier."}, {"type": "audio", "content": "engenn7le18ob02aud10"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "powder"}, {"type": "definition", "content": "tiny pieces made by crushing something"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: She got some green tea powder to use in a cake."}, {"type": "audio", "content": "engenn7le18ob02aud09"}]}, {"type": "background_image", "content": "engenn7le18ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Describe a dish you have made at home."}, {"type": "text", "content": "Write a dialogue about making the dish."}, {"type": "text", "content": "Ask for advice about making the dish."}, {"type": "text", "content": "Practice the dialogue with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "l describe a dish I have made."}, {"type": "text", "content": "I talk about a making a dish."}, {"type": "text", "content": "I ask for advice."}]}], "type": "sena"}