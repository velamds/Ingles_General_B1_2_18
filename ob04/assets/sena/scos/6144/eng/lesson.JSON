ntents": [{"value": {"audiosrc": "engenn7le18ob04re2aud01", "images": [{"image": "engenn7le18ob04re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn7le18ob04re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Let's go along here. I want to get a rice cooker.<br/>\n<span class=\"strong\">Sally</span>: Wow. I've never tried one out.<br/>\n<span class=\"strong\">Vanessa</span>: I was thinking I could use it to whip up rice dishes quickly and efficiently.<br/>\n<span class=\"strong\">Sally</span>: Like what?<br/>\n<span class=\"strong\">Vanessa</span>: I have a recipe for squid that's chopped up, then mixed with herbed fried rice that looks delicious!", "time": "100"}, {"image": "engenn7le18ob04re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>: Squid makes me squeamish. Don't they squirt black ink?<br/>\n<span class=\"strong\">Vanessa</span>: There's a little sac of it inside them that you squeeze out. <br/>\n<span class=\"strong\">Sally</span>: Ick! Squishy seafood!<br/>\n<span class=\"strong\">Vanessa</span>: OK. Would squab stuffed with wild rice, cranberries and nuts be better for you?<br/>\n<span class=\"strong\">Sally</span>: I think so. <br/>\n<span class=\"strong\">Vanessa</span>: Acorn squash hollowed out and filled with zucchini and rice is also a nice staple.", "time": "13500"}, {"image": "engenn7le18ob04re2img03.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: What are we going to do after the cook-in?<br/>\n<span class=\"strong\">Vanessa</span>: Could we listen to music and talk?<br/>\n<span class=\"strong\">Sally</span>: Marleene might leave early. Could we go out for coffee and see a movie or do a little window shopping?<br/>\n<span class=\"strong\">Vanessa</span>: Could we walk along the Charles River starting at Kendal Square and then listen to the buskers along the esplanade? <br/>\n<span class=\"strong\">Sally</span>: Could we end up coming back for some more of your green tea cake?<br/>\n<span class=\"strong\">Vanessa</span>: Sounds like we've come up with some good ideas!", "time": "31500"}], "coverimg": "engenn7le18ob04re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}, {"id": 2, "contents": [], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}